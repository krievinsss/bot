# Database (recommended: Prisma Postgres or another managed PostgreSQL on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Telegram
BOT_TOKEN=""
BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET="replace-with-random-secret"

# PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_MODE="sandbox"

# Application security
ADMIN_SESSION_SECRET="replace-with-32+-byte-random-secret"
DATA_ENCRYPTION_KEY="base64-encoded-32-byte-key"
APP_URL="http://localhost:3000"
CRON_SECRET="replace-with-random-secret"

# Vercel Blob (injected automatically when a Blob store is connected)
BLOB_READ_WRITE_TOKEN=""

# Seed-only development admin; remove after initial setup
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe-Immediately-123!"
